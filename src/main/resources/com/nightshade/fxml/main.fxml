<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!--
  Nightshade v3.5.0 Premium Obsidian Layout
  Adheres to taste-skill guidelines:
    - Double-Bezel nested panel architecture for all controls
    - Button-in-Button interactive controls
    - Symmetric spacing and clean high-density developer styling
    
  Layout fix: Strategy checkboxes moved to 2-column GridPane to halve their
  vertical footprint and give the file tree enough space to display.
-->
<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="ALWAYS"
            style="-fx-background: #0B0C12; -fx-background-color: #0B0C12;"
            xmlns="http://javafx.openjfx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.nightshade.controller.MainController">
    <BorderPane styleClass="root-pane">

    <!-- ── TOP: Header Bar ────────────────────────────────────────────── -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT">
            <Label text="☽" styleClass="logo-glyph" />
            <Label text="NIGHTSHADE" styleClass="app-title" />
            <Label text="v3.5.0" styleClass="version-badge" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="statusLabel" text="READY" styleClass="status-ready" />
            <Button fx:id="aboutBtn" text="About" styleClass="header-btn"
                    onAction="#onAboutClicked" />
        </HBox>
    </top>

    <!-- ── LEFT: Side Panel (Control Drawer) ─────────────────────────── -->
    <left>
        <VBox styleClass="left-panel" prefWidth="270" spacing="0">

            <!-- Input directory picker (Double-Bezel) -->
            <VBox styleClass="control-section-outer">
                <VBox styleClass="control-section" spacing="4">
                    <Label text="INPUT DIRECTORY" styleClass="section-label" />
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <TextField fx:id="inputPathField" styleClass="path-field"
                                   promptText="Select directory..." HBox.hgrow="ALWAYS" />
                        <Button text="..." styleClass="browse-btn" onAction="#onBrowseInput"
                                fx:id="browseInputBtn" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- File tree (Standalone content pane) — gets all remaining space -->
            <VBox styleClass="tree-section-outer" VBox.vgrow="ALWAYS" minHeight="150">
                <VBox styleClass="tree-section" VBox.vgrow="ALWAYS" spacing="4" minHeight="140">
                    <Label text="TARGET FILES" styleClass="section-label" />
                    <TreeView fx:id="fileTreeView" styleClass="file-tree"
                              VBox.vgrow="ALWAYS" minHeight="120" />
                </VBox>
            </VBox>

            <!-- Output directory picker (Double-Bezel) -->
            <VBox styleClass="control-section-outer">
                <VBox styleClass="control-section" spacing="4">
                    <Label text="OUTPUT DIRECTORY" styleClass="section-label" />
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <TextField fx:id="outputPathField" styleClass="path-field"
                                   promptText="Auto-generated..." HBox.hgrow="ALWAYS" />
                        <Button text="..." styleClass="browse-btn" onAction="#onBrowseOutput"
                                fx:id="browseOutputBtn" />
                    </HBox>
                </VBox>
            </VBox>

            <!-- Strategy checkboxes — 2-column GridPane to halve vertical footprint -->
            <VBox styleClass="control-section-outer">
                <VBox styleClass="control-section" spacing="4">
                    <Label text="OBFUSCATION STRATEGIES" styleClass="section-label" />
                    <GridPane hgap="6" vgap="4">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                        </columnConstraints>
                        <CheckBox fx:id="cbEntropy"    text="Entropy Scramble" styleClass="strategy-cb" selected="true"  GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <CheckBox fx:id="cbDeadCode"   text="Dead Code"        styleClass="strategy-cb" selected="true"  GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <CheckBox fx:id="cbComments"   text="Comment Poison"   styleClass="strategy-cb" selected="true"  GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <CheckBox fx:id="cbStrings"    text="String Encode"    styleClass="strategy-cb" selected="true"  GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <CheckBox fx:id="cbWhitespace" text="Whitespace Disrupt" styleClass="strategy-cb" selected="true" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <CheckBox fx:id="cbSemantic"   text="Semantic Invert"  styleClass="strategy-cb" selected="false" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <CheckBox fx:id="cbControlFlow" text="Control Flow"    styleClass="strategy-cb" selected="false" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <CheckBox fx:id="cbWatermark"  text="Watermark"        styleClass="strategy-cb" selected="false" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    </GridPane>
                </VBox>
            </VBox>

            <!-- Run Control / Action Center (Double-Bezel) -->
            <VBox styleClass="control-section-outer">
                <VBox styleClass="control-section" spacing="6">
                    <ProgressBar fx:id="progressBar" styleClass="entropy-bar" maxWidth="Infinity" progress="0" />
                    <Label fx:id="entropyLabel" text="Entropy Level: 0.000" styleClass="entropy-label" />
                    <!-- Button-in-Button layout -->
                    <Button fx:id="runBtn" styleClass="run-btn" maxWidth="Infinity" onAction="#onRunClicked">
                        <graphic>
                            <HBox alignment="CENTER" spacing="10" mouseTransparent="true">
                                <Label fx:id="runBtnIcon" text="⚡" styleClass="run-btn-icon-wrapper" />
                                <Label fx:id="runBtnText" text="RUN NIGHTSHADE" styleClass="run-btn-text" />
                            </HBox>
                        </graphic>
                    </Button>
                </VBox>
            </VBox>

        </VBox>
    </left>

    <!-- ── CENTER: Diff Editor Panel ──────────────────────────────────── -->
    <center>
        <VBox styleClass="center-panel">

            <!-- Diff headers -->
            <HBox styleClass="diff-header" spacing="0">
                <Label text="ORIGINAL SOURCE" styleClass="diff-label-left" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                <Label text="POISONED OUTPUT" styleClass="diff-label-right" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
            </HBox>

            <!-- Synchronized split code editors -->
            <SplitPane fx:id="diffSplitPane" VBox.vgrow="ALWAYS" dividerPositions="0.5" minHeight="0">
                <TextArea fx:id="sourceView" styleClass="code-view source-view"
                          editable="false" wrapText="false"
                          promptText="Select a target file to preview..." />
                <TextArea fx:id="poisonedView" styleClass="code-view poisoned-view"
                          editable="false" wrapText="false"
                          promptText="Click RUN NIGHTSHADE to view poisoned output..." />
            </SplitPane>
        </VBox>
    </center>

    <!-- ── BOTTOM: Console Logs & Dashboard Metrics ───────────────────── -->
    <bottom>
        <VBox styleClass="bottom-panel" minHeight="200">

            <!-- Stats Bar (Hidden by default, holds metrics cards) -->
            <HBox fx:id="statsBar" styleClass="stats-bar" spacing="12" visible="false" managed="false" alignment="CENTER_LEFT">
                <VBox styleClass="stat-item-outer">
                    <VBox styleClass="stat-item" spacing="1">
                        <Label text="FILES" styleClass="stat-key" />
                        <Label fx:id="statFiles" text="0" styleClass="stat-val" />
                    </VBox>
                </VBox>
                <VBox styleClass="stat-item-outer">
                    <VBox styleClass="stat-item" spacing="1">
                        <Label text="RENAMED" styleClass="stat-key" />
                        <Label fx:id="statRenamed" text="0" styleClass="stat-val stat-amber" />
                    </VBox>
                </VBox>
                <VBox styleClass="stat-item-outer">
                    <VBox styleClass="stat-item" spacing="1">
                        <Label text="DEAD BLOCKS" styleClass="stat-key" />
                        <Label fx:id="statDead" text="0" styleClass="stat-val stat-red" />
                    </VBox>
                </VBox>
                <VBox styleClass="stat-item-outer">
                    <VBox styleClass="stat-item" spacing="1">
                        <Label text="COMMENTS" styleClass="stat-key" />
                        <Label fx:id="statComments" text="0" styleClass="stat-val stat-purple" />
                    </VBox>
                </VBox>
                <VBox styleClass="stat-item-outer">
                    <VBox styleClass="stat-item" spacing="1">
                        <Label text="STRINGS" styleClass="stat-key" />
                        <Label fx:id="statStrings" text="0" styleClass="stat-val stat-blue" />
                    </VBox>
                </VBox>
                <VBox styleClass="stat-item-outer">
                    <VBox styleClass="stat-item" spacing="1">
                        <Label text="AVG ENTROPY" styleClass="stat-key" />
                        <Label fx:id="statEntropy" text="0.000" styleClass="stat-val stat-green" />
                    </VBox>
                </VBox>
                <VBox styleClass="stat-item-outer">
                    <VBox styleClass="stat-item" spacing="1">
                        <Label text="TIME" styleClass="stat-key" />
                        <Label fx:id="statTime" text="0ms" styleClass="stat-val" />
                    </VBox>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Open Output" styleClass="open-output-btn"
                        onAction="#onOpenOutput" fx:id="openOutputBtn" />
            </HBox>

            <!-- Console Log Panel -->
            <VBox styleClass="log-panel-outer">
                <VBox styleClass="log-panel">
                    <HBox styleClass="log-header" spacing="8" alignment="CENTER_LEFT">
                        <Label text="SYSTEM LOG" styleClass="section-label" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="CLEAR" styleClass="log-clear-btn" onAction="#onClearLog" />
                    </HBox>
                    <ListView fx:id="logView" styleClass="log-view" minHeight="150" prefHeight="150" VBox.vgrow="ALWAYS" />
                </VBox>
            </VBox>

        </VBox>
    </bottom>

</BorderPane>
</ScrollPane>